ame" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#c9a227;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=8;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1076" y="232" width="140" height="60" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;none&lt;/b&gt;&lt;br&gt;other host, after,&lt;br&gt;or too long before" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f2f4;strokeColor=#9aa3b2;fontSize=11;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=8;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1226" y="232" width="156" height="60" as="geometry"/></mxCell><mxCell id="c55" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dde1e7;fontSize=12;fontColor=#1d2330;align=center;verticalAlign=middle;arcSize=8;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="910" y="330" width="486" height="280" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b&gt;Where it shows&lt;/b&gt;" style="text;html=1;fontSize=13;fontColor=#1d2330;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=2;" vertex="1" parent="1"><mxGeometry x="926" y="338" width="450" height="24" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;What changed&lt;/b&gt;: a line joins the two markers in the lane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a9bb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=middle;arcSize=8;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="926" y="370" width="456" height="52" as="geometry"/></mxCell><mxCell id="c58" value="&lt;b&gt;Map&lt;/b&gt;: the problem says&lt;br&gt;&amp;quot;1 min after image relay:4 → relay:5&amp;quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a9bb8;fontSize=12;fontColor=#1d2330;align=left;verticalAlign=middle;arcSize=8;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="926" y="432" width="456" 